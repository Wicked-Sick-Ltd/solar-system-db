# Public hostname for Caddy (used by docker-compose + Caddyfile)
# When fronted by Cloudflare Tunnel, this is the hostname Cloudflare maps to.
PUBLIC_HOSTNAME=solar.example.com

# Optional: override the default ports if 80/443 are in use
# HTTP_PORT=8080
# HTTPS_PORT=8443

# --- API host: where pull_latest.sh fetches the nightly artefact from ---
MANIFEST_URL=https://download.sol.wickedsick.com/latest.json

# --- Build host only (profile "build"): publish target + crawler rate ---
# S3_BUCKET=solar-system-db
# S3_ENDPOINT=https://4ce32b0dd5d81195ffdef6d24d1a8297.r2.cloudflarestorage.com
# S3_PUBLIC_BASE=https://download.sol.wickedsick.com
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: inject with `op run` — never write them here
# CRAWLER_RPS=1.0

# --- Public API fair-use keys (api/fair_use.py) ---
# Keys travel in the X-PU-Api-Key header. A missing, invalid, or revoked key
# is anonymous per-IP traffic. Hashes only are stored. Do not commit secrets.
# Compose already sets the container path to
# /var/lib/publicuniverse/api_keys.sqlite on the writable `api_keys` volume.
# PU_API_KEYS_PATH=/var/lib/solar-system-db/api_keys.sqlite
# Pepper is passed into rest-api. Leave it empty until you set one.
# PU_API_KEY_PEPPER=
# Optional JSON list of {"key","tier","label"} objects, hashed on startup.
# Leave unset. PU_API_KEYS=
# Institution calls/day. Default 100000 pending review.
# PU_INSTITUTION_PER_DAY=100000
# PU_API_ACCESS_URL=https://publicuniverse.net/api-access
# PU_TRUSTED_PROXIES=
