[Unit]
Description=solar-system-db nightly full build and publish
# After=docker.service is inert in a user unit (cannot order against system units); kept for documentation only.
After=docker.service
[Service]
Type=oneshot
WorkingDirectory=%h/deploy/solar-system-db
Environment=SOLAR_DATA_DIR=%h/deploy/solar-data
# No EnvironmentFile=: the op token file uses `export KEY=…`, which systemd rejects
# and echoes into the journal. build/run_build.sh sources it instead.
ExecStart=/bin/sh %h/deploy/solar-system-db/build/run_build.sh
# ExecStopPost (not ExecStartPost) runs on failure too; systemd sets
# $SERVICE_RESULT / $EXIT_STATUS, which mcp_notify.py turns into a failure post.
ExecStopPost=/bin/sh -c 'python3 %h/deploy/solar-system-db/build/mcp_notify.py || true'
