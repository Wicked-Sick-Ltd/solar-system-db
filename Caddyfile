# solar-system-db reverse proxy.
#
# By default Caddy will request a Let's Encrypt cert for $PUBLIC_HOSTNAME when
# bound to 80/443. If you're putting this behind Cloudflare Tunnel, set
# `auto_https off` and Cloudflare handles TLS — see README, "Hosting it publicly".

{
	# Set in .env: PUBLIC_HOSTNAME=solar.example.com
	# Uncomment for tunnel-only deployments:
	# auto_https off
	admin off
}

{$PUBLIC_HOSTNAME:localhost} {
	encode gzip zstd

	# REST API (OpenAPI/Swagger UI at /docs, ReDoc at /redoc)
	handle_path /api/* {
		rewrite * /api{uri}
		reverse_proxy rest-api:8003
	}
	handle /docs* {
		reverse_proxy rest-api:8003
	}
	handle /redoc* {
		reverse_proxy rest-api:8003
	}
	handle /openapi.json {
		reverse_proxy rest-api:8003
	}

	# MCP streamable-HTTP endpoint.
	# Observing quotas are enforced in the MCP process (see solar_db/http_quotas.py).
	# The stock Caddy image has no rate-limit module; do not add a custom build
	# for that. Caddy's source address is the compose network, not loopback, so
	# forwarded headers are ignored unless MCP_TRUSTED_PROXIES lists that proxy.
	# Until then every caller shares the proxy peer's quota bucket.
	handle /mcp* {
		request_body {
			max_size 64kB
		}
		reverse_proxy mcp-server:8002
	}

	# Landing page (everything else)
	handle {
		root * /srv
		file_server
	}

	header {
		# Conservative security headers; no PII to leak here, but good hygiene
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CORS — read-only, public; allow any browser to call the API
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
	}
}
